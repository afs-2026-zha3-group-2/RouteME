# Maven
target/
# 开发态专用输出（pom 的 dev-run profile）：与 target/ 分开，测试编译不会打断正在运行的后端
target-run/
.mvn/wrapper/maven-wrapper.jar

# Node
node_modules/
dist/
*.local

# Database files
*.db
*.db-journal
*.sqlite

# IDE
# Ignore every IntelliJ project folder, but share the root VCS root mapping so
# every clone knows the only Git root is the workspace root (no ai4se-baseline).
.idea/
!/.idea/
/.idea/*
!/.idea/vcs.xml
*.iml
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/launch.json
.metals/
.bloop/
_ao_ppt_build

# OS
.DS_Store
Thumbs.db

# Playwright (预留)
test-results/
playwright-report/

# Logs (logback writes to backend/logs via LOG_PATH; never commit log files)
*.log
logs/

# Local SQLite workspace (keep the folder, ignore data files)
ai4se-baseline/RouteME/SqlLite/*.db
ai4se-baseline/RouteME/SqlLite/*.db-journal
ai4se-baseline/RouteME/SqlLite/*.lock.db
# Avatar uploads are runtime data written by the profile feature
ai4se-baseline/RouteME/SqlLite/uploads/
ai4se-baseline/RouteME/backend/data/

# Build output that CI copies the frontend dist into
ai4se-baseline/RouteME/backend/src/main/resources/static/

# Local AMap web-service key for the backend proxy (never commit real keys)
ai4se-baseline/RouteME/backend/amap-local.yml
