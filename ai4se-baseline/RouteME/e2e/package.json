{
  "name": "routeme-e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "node ../../scripts/e2e-smoke.mjs",
    "test:changed": "playwright test --only-changed=origin/main",
    "test:last-failed": "playwright test --last-failed",
    "test:full": "playwright test --reporter=line",
    "test:shards": "node ../../scripts/e2e-shard.mjs",
    "debt:diff": "node ../../scripts/e2e-debt-diff.mjs --root ../.."
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2"
  }
}
