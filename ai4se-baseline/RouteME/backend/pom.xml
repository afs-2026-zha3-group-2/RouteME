<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>routeme</groupId>
	<artifactId>routeme-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>routeme-backend</name>
	<description>RouteME backend</description>
	<properties>
		<java.version>21</java.version>
		<mybatis-plus.version>3.5.18</mybatis-plus.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-spring-boot4-starter</artifactId>
			<version>${mybatis-plus.version}</version>
		</dependency>
		<!-- 3.5.9 起分页拦截器拆到 jsqlparser 模块，必须显式引入。 -->
		<dependency>
			<groupId>com.baomidou</groupId>
			<artifactId>mybatis-plus-jsqlparser</artifactId>
			<version>${mybatis-plus.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Lombok：日志统一用 @Slf4j，不手写 LoggerFactory。 -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- Flyway 12 把 SQLite 支持拆成独立模块，版本必须与 flyway-core 一致。 -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-nc-sqlite</artifactId>
			<version>${flyway.version}</version>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<!--
		开发态与构建/测试态共用 target/classes 会互相踩踏：maven-compiler-plugin 做全量重编译时会
		先清空输出目录，正在运行的 `spring-boot:run` 就短暂读不到 class，抛 NoClassDefFoundError；
		而 JVM 会把这次「找不到类」缓存下来，之后所有请求（含异常处理里的 ErrorResponse）持续失败，
		直到重启进程。dev-run 把开发态输出隔离到 target-run/，`mvnw test`/`compile` 只动 target/。
	-->
	<profiles>
		<profile>
			<id>dev-run</id>
			<build>
				<directory>${project.basedir}/target-run</directory>
			</build>
		</profile>
	</profiles>

</project>
